# MongoDB Atlas connection string. Do not commit .env.
DATABASE_URL="mongodb+srv://DATABASE_USER:NEW_PASSWORD@dwa-leads.vgwvq6f.mongodb.net/dwa_leads?retryWrites=true&w=majority"

# Generate with: openssl rand -base64 48
SESSION_SECRET="replace-with-a-random-secret-of-at-least-32-characters"

# Used once by `npm run bootstrap-admin` after migrations have been deployed.
INITIAL_ADMIN_NAME="Operations Admin"
INITIAL_ADMIN_EMAIL="admin@example.com"
INITIAL_ADMIN_PASSWORD="replace-with-a-strong-unique-password"

# Gemini keys are tried in order. The backup is used automatically when the primary is rate-limited or rejected.
GEMINI_API_KEY="your-primary-gemini-api-key"
GEMINI_API_KEY_BACKUP="your-backup-gemini-api-key"
GEMINI_API_KEY_2="your-third-gemini-api-key"
GEMINI_API_KEY_3="your-fourth-gemini-api-key"
# Add GEMINI_API_KEY_4, GEMINI_API_KEY_5, etc. for more fallback keys.
